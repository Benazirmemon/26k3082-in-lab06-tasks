#include <stdio.h>

int main()
{
    char item[50];
    float price, total = 0;
    int choice, count = 0;

    do
    {
        printf("Enter food item: ");
        scanf("%s", item);

        printf("Enter price: ");
        scanf("%f", &price);

        total = total + price;
        count++;

        printf("Order another item? (1=Yes, 0=No): ");
        scanf("%d", &choice);

    } while(choice == 1);

    printf("Total bill = %.2f\n", total);
    printf("Number of items = %d", count);
}





    
