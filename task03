#include <stdio.h>
int main() {
    int num;
    printf("Enter a number (0 to stop): ");
    scanf("%d", &num);
    
    while(num != 0) {
        int cube = num * num * num;
        printf("Cube of %d is %d\n", num, cube);
        
        printf("Enter a number (0 to stop): ");
        scanf("%d", &num);
    }
   
}
