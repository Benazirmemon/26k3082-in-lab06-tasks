#include <stdio.h>

int main()
{
    int salary[6];
    int i, count = 0;

    for(i = 0; i < 6; i++)
    {
        printf("Enter salary of employee %d: ", i + 1);
        scanf("%d", &salary[i]);

        if(salary[i] > 50000)
        {
            count++;
        }
    }

    printf("Employee Salaries:");

    for(i = 0; i < 6; i++)
    {
        printf("%d", salary[i]);
    }

    printf("no of employees whose salary greater than 50000 = %d", count);

   
}
