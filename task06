#include<stdio.h>
int main()
{
    float amount, total = 0;
    int deposits = 0;

    while(1)
    {
        printf("Enter saved amount: ");
        scanf("%f", &amount);

        if(amount <= 0)
        {
            break;
        }

        total = total + amount;
        deposits++;
    }

    printf("Total savings = %.2f\n", total);
    printf("Number of deposits = %d", deposits);
}



  
